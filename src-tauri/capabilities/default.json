{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    { "identifier": "fs:allow-read-text-file", "allow": [{ "path": "**/*.nai" }] },
    { "identifier": "fs:allow-write-text-file", "allow": [{ "path": "**/*.nai" }] },
    { "identifier": "fs:allow-remove", "allow": [{ "path": "**/*.nai" }] }
  ]
}